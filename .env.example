# Copy to web/.env.local for local development (never commit real values).

# PostgreSQL connection used by the web app and migrations.
DATABASE_URL=postgres://klierly:klierly_dev@127.0.0.1:5432/klierly

# Long random string (32+ chars). Encrypts saved AI API keys at rest and signs
# internal values. Generate with: openssl rand -base64 48
# Changing it makes previously saved AI keys unreadable (re-enter them).
APP_SECRET=change-me-generate-a-long-random-string-please

# Public origin of the web app. Use https:// in production.
APP_URL=http://localhost:3000

# Python worker (parsing + numerical validation). The token must match the
# worker's WORKER_TOKEN. The worker must never be exposed publicly.
WORKER_URL=http://127.0.0.1:8001
WORKER_TOKEN=change-me-worker-shared-secret

# Where uploaded originals are stored (outside the web root).
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=25

# Registration. If set, creating an account requires this code.
# If empty, only the very first account can be created (local owner).
INVITE_CODE=

# Time zone used for "today" in study plans and for displayed times (IANA name).
TZ=America/New_York

# Allow AI endpoints on localhost / private networks (self-hosted models).
# Keep "true" for local use; set "false" on a shared public deployment.
ALLOW_PRIVATE_AI_ENDPOINTS=true

# --- Klierly-managed AI (optional; makes AI work for students with no key) ---
# Leave these three empty to keep managed AI OFF. With it off, students only get
# AI if they connect their own provider. Setting them starts spending on YOUR
# provider account — do not set them until you have chosen and funded one.
MANAGED_AI_BASE_URL=
MANAGED_AI_API_KEY=
# Inexpensive model used for routine work (notes, first attempt at questions).
MANAGED_AI_MODEL=
# Optional stronger model, used only for the retry after drafts failed validation.
MANAGED_AI_MODEL_STRONG=
MANAGED_AI_LABEL=Klierly AI
# Free allowance per student, and safety caps across all students.
MANAGED_AI_USER_DAILY_REQUESTS=40
MANAGED_AI_USER_MONTHLY_TOKENS=400000
MANAGED_AI_GLOBAL_DAILY_REQUESTS=500
# Stop all managed AI for the month once estimated spend reaches this (US dollars). Needs prices below.
MANAGED_AI_GLOBAL_MONTHLY_USD=10
# Your provider's prices in US dollars per million tokens, for the spend estimate.
MANAGED_AI_PRICE_IN_PER_MTOK=
MANAGED_AI_PRICE_OUT_PER_MTOK=
MANAGED_AI_STRONG_PRICE_IN_PER_MTOK=
MANAGED_AI_STRONG_PRICE_OUT_PER_MTOK=
# Administrator access is bound to an existing user UUID by scripts/bootstrap-owner.ts.
# Set true only when the origin is reachable exclusively through your trusted Cloudflare Tunnel.
TRUST_CLOUDFLARE=false

# Optional: where instructors or rights holders can ask for class-library items to be removed (shown on /terms/sharing).
TAKEDOWN_EMAIL=

# --- Docker Compose only -------------------------------------------------
# Database password for the bundled PostgreSQL container.
POSTGRES_PASSWORD=change-me-db-password
# Public deployment overlay (docker-compose.prod.yml) only:
# DOMAIN=klierly.example.com

# Optional: calculation questions in Learn Mode run AI-written code, so they need a separate, isolated solver container.
# Enable with all three: COMPOSE_PROFILES=solver, SOLVER_TOKEN (a new secret, different from WORKER_TOKEN) and WORKER_SOLVER_URL.
# Leave empty to build conceptual questions only. See docs/learn-mode/solver.md
COMPOSE_PROFILES=
SOLVER_TOKEN=
WORKER_SOLVER_URL=
